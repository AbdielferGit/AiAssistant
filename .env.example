# Copia este archivo a ".env" y rellena los valores.
# NUNCA subas el ".env" real a git (ya está en .gitignore).

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Google Cloud (Gmail + Drive) ---
# Se obtienen en Google Cloud Console → APIs & Services → Credentials
# (ver scripts/setup_google_cloud.md)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2callback
# ID de la carpeta de Drive donde se respalda la base de datos local
GOOGLE_DRIVE_DB_FOLDER_ID=
# ID de la carpeta de Drive donde orchestrator/web/app.py (ruta /reels)
# deposita cada reel generado — opcional, si se deja vacío simplemente no
# sube nada a Drive (el .mp4 igual queda en data/reels/ y se puede
# descargar desde la propia página). Sacá el ID de la URL de la carpeta:
# drive.google.com/drive/folders/<ESTE_ID>
GOOGLE_DRIVE_REELS_FOLDER_ID=

# --- WhatsApp Cloud API (Meta, oficial — único proveedor soportado) ---
# Todo esto sale del panel de Meta for Developers → tu App → WhatsApp →
# API Setup (ver MANUAL_CONEXION.md sección 3).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
# Cadena que tú inventas; la vuelves a pegar en el panel de Meta al
# configurar el Webhook (Configuration → Webhook → Verify token). Solo
# hace falta si vas a correr orchestrator/webhooks/whatsapp_cloud.py para
# recibir WhatsApp entrante — enviar_whatsapp funciona sin esto.
WHATSAPP_CLOUD_API_VERIFY_TOKEN=cambia-esto-por-una-cadena-aleatoria

# --- Messenger (opcional, ver orchestrator/tools/messenger.py) ---
# Deja vacío hasta decidir si usas Meta Messenger Platform (oficial, solo Páginas)
MESSENGER_PAGE_ACCESS_TOKEN=

# --- Memoria / estilo ---
VECTOR_DB_PATH=./data/vector_store
INBOUND_TRACKER_PATH=./data/whatsapp_last_inbound.json

# --- Web (orchestrator/web/, ver docs/DEPLOY_BLUEHOST.md) ---
# Cadena aleatoria larga para firmar las cookies de sesión del login web.
# Si la dejas vacía, el servidor genera una de un solo uso al arrancar y
# TODAS las sesiones se invalidan cada reinicio — solo aceptable en
# desarrollo local, nunca en producción.
WEB_SESSION_SECRET=

# --- ElevenLabs (agente "productor_reels" — proveedor de voz por
# defecto, ver orchestrator/tools/reels_defaults.py) ---
# Sacala en elevenlabs.io/app/settings/api-keys (con permiso de
# text-to-speech habilitado). Si el voice_id que usás (ver
# reels_defaults.ELEVENLABS_VOZ_ID_POR_DEFECTO) es de la Voice Library
# (no una voz propia), ElevenLabs exige plan pago para usarla por API —
# el plan Free tira 402 Payment Required aunque la misma voz sea gratis
# en su web.
ELEVENLABS_API_KEY=

# --- Azure Speech (agente "productor_reels" — proveedor de respaldo si
# ElevenLabs no está disponible, ver orchestrator/tools/reel_generator.py) ---
# Necesario SOLO para generar reels con narración en francés quebequense
# (fr-CA). Crea un recurso "Speech" en portal.azure.com (tiene capa
# gratuita — 0.5M caracteres/mes) → Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Voz fr-CA a usar. Por defecto la voz "HD" (más natural, detecta
# emoción del texto sola) — la doc de Azure dice que las voces HD ignoran
# <prosody rate>/<emphasis>, pero es FALSO (verificado: el ritmo sí cambia
# la duración del audio). PLANTILLA_RITMO_PCT y PLANTILLA_PAUSA_MS (ver
# reel_generator.py) sí tienen efecto real con esta voz. Otras HD:
# fr-CA-Thierry:DragonHDLatestNeural (masculina). Estándar: fr-CA-Sylvie-
# Neural, fr-CA-AntoineNeural, fr-CA-JeanNeural, fr-CA-ThierryNeural.
# NUNCA una voz fr-FR — el proyecto exige acento quebequense, no de Francia.
AZURE_SPEECH_VOICE_FR_CA=fr-CA-Sylvie:DragonHDLatestNeural

# --- Video real con IA — Google Veo (agente "productor_reels", ver
# orchestrator/tools/video_ia.py) ---
# API key simple de Gemini — sacala en aistudio.google.com/apikey. OJO
# (verificado en vivo, la doc oficial no lo aclara): esa key sola NO
# alcanza para Veo — el tier gratis solo cubre texto/imagen. Hay que
# habilitar FACTURACIÓN en el proyecto de AI Studio (mismo proyecto, no
# uno de Vertex AI aparte) o cualquier pedido de video devuelve 429
# RESOURCE_EXHAUSTED. Esto es DISTINTO del pipeline de mockups/íconos con
# Pillow — genera metraje real con IA generativa (Veo), no dibuja nada.
GEMINI_API_KEY=
# Modelo de Veo a usar. Por defecto el completo; "veo-3.1-fast-generate-preview"
# es más rápido/barato, "veo-3.1-lite-generate-preview" el más económico
# (sin 4k ni extensión de video).
GEMINI_VEO_MODEL=veo-3.1-generate-preview
