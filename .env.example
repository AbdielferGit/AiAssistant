# Copia este archivo a ".env" y rellena los valores.
# NUNCA subas el ".env" real a git (ya está en .gitignore).

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Google Cloud (Gmail + Drive) ---
# Se obtienen en Google Cloud Console → APIs & Services → Credentials
# (ver scripts/setup_google_cloud.md)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2callback
# ID de la carpeta de Drive donde se respalda la base de datos local
GOOGLE_DRIVE_DB_FOLDER_ID=

# --- WhatsApp Cloud API (Meta, oficial — único proveedor soportado) ---
# Todo esto sale del panel de Meta for Developers → tu App → WhatsApp →
# API Setup (ver MANUAL_CONEXION.md sección 3).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
# Cadena que tú inventas; la vuelves a pegar en el panel de Meta al
# configurar el Webhook (Configuration → Webhook → Verify token). Solo
# hace falta si vas a correr orchestrator/webhooks/whatsapp_cloud.py para
# recibir WhatsApp entrante — enviar_whatsapp funciona sin esto.
WHATSAPP_CLOUD_API_VERIFY_TOKEN=cambia-esto-por-una-cadena-aleatoria

# --- Messenger (opcional, ver orchestrator/tools/messenger.py) ---
# Deja vacío hasta decidir si usas Meta Messenger Platform (oficial, solo Páginas)
MESSENGER_PAGE_ACCESS_TOKEN=

# --- Memoria / estilo ---
VECTOR_DB_PATH=./data/vector_store
INBOUND_TRACKER_PATH=./data/whatsapp_last_inbound.json

# --- Web (orchestrator/web/, ver docs/DEPLOY_BLUEHOST.md) ---
# Cadena aleatoria larga para firmar las cookies de sesión del login web.
# Si la dejas vacía, el servidor genera una de un solo uso al arrancar y
# TODAS las sesiones se invalidan cada reinicio — solo aceptable en
# desarrollo local, nunca en producción.
WEB_SESSION_SECRET=
